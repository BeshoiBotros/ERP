<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_disbursement_form" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.form</field>
        <field name="model">eh.daily.disbursement</field>
        <field name="arch" type="xml">
            <form string="Daily Disbursement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="eh_daily_disbursement.group_daily_disbursement_user"/>
                    <button name="action_close" type="object" string="Close Day" class="oe_highlight"
                            invisible="state != 'confirmed'"
                            groups="eh_daily_disbursement.group_daily_disbursement_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="eh_daily_disbursement.group_daily_disbursement_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"
                            groups="eh_daily_disbursement.group_daily_disbursement_user"
                            confirm="Cancel this sheet? Its lines stay on record but no longer count."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'confirmed'"
                            groups="eh_daily_disbursement.group_daily_disbursement_manager"
                            confirm="Cancel this confirmed sheet? Its lines stay on record but no longer count."/>
                    <button name="action_copy_previous" type="object" string="Copy Previous Sheet"
                            invisible="state != 'draft' or line_count"
                            groups="eh_daily_disbursement.group_daily_disbursement_user"/>
                    <button name="%(action_daily_disbursement_import)d" type="action" string="Import Lines"
                            invisible="state != 'draft'" context="{'default_sheet_id': id}"
                            groups="eh_daily_disbursement.group_daily_disbursement_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button"
                                icon="fa-bar-chart" invisible="not line_count">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="tag_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="responsible_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="allowed_categ_ids" invisible="1"/>
                        </group>
                    </group>

                    <group string="Summary" col="3">
                        <group>
                            <field name="disbursed_cost" decoration-danger="disbursed_cost"/>
                            <field name="disbursed_qty"/>
                        </group>
                        <group>
                            <field name="returned_cost" decoration-success="returned_cost"/>
                            <field name="returned_qty"/>
                        </group>
                        <group>
                            <field name="net_cost" decoration-bf="1"/>
                            <field name="net_qty" decoration-bf="1"/>
                        </group>
                    </group>

                    <group string="Approval" invisible="not confirmed_by_id">
                        <group>
                            <field name="confirmed_by_id" widget="many2one_avatar_user"/>
                            <field name="confirmed_date"/>
                        </group>
                        <group invisible="not closed_by_id">
                            <field name="closed_by_id" widget="many2one_avatar_user"/>
                            <field name="closed_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Disbursed" name="disbursed">
                            <field name="disbursement_line_ids" readonly="state != 'draft'"
                                   context="{'default_move_type': 'out'}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="move_type" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_id" options="{'no_create': True}"
                                           domain="[('type', '!=', 'service'), ('categ_id', 'child_of', parent.allowed_categ_ids)]"/>
                                    <field name="qty"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="unit_cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="subtotal" sum="Total Disbursed"/>
                                    <field name="note" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Returned" name="returned">
                            <field name="return_line_ids" readonly="state != 'draft'"
                                   context="{'default_move_type': 'return'}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="move_type" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_id" options="{'no_create': True}"
                                           domain="[('type', '!=', 'service'), ('categ_id', 'child_of', parent.allowed_categ_ids)]"/>
                                    <field name="qty"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="unit_cost"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="subtotal" sum="Total Returned"/>
                                    <field name="note" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Anything worth knowing about this day..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_daily_disbursement_tree" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.tree</field>
        <field name="model">eh.daily.disbursement</field>
        <field name="arch" type="xml">
            <tree string="Daily Disbursements" sample="1"
                  decoration-info="state == 'draft'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="tag_id"/>
                <field name="responsible_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="line_count" optional="hide"/>
                <field name="disbursed_cost" sum="Total Disbursed"/>
                <field name="returned_cost" sum="Total Returned"/>
                <field name="net_cost" sum="Net Cost" decoration-bf="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="view_daily_disbursement_search" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.search</field>
        <field name="model">eh.daily.disbursement</field>
        <field name="arch" type="xml">
            <search string="Daily Disbursements">
                <field name="name"/>
                <field name="tag_id"/>
                <field name="responsible_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Yesterday" name="yesterday"
                        domain="[('date', '=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="My Sheets" name="my_sheets" domain="[('responsible_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Day" name="group_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Category Tag" name="group_tag" context="{'group_by': 'tag_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_daily_disbursement" model="ir.actions.act_window">
        <field name="name">Daily Sheets</field>
        <field name="res_model">eh.daily.disbursement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_daily_disbursement_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create today's disbursement sheet
            </p>
            <p>
                Record the products handed out and brought back each day;
                the sheet totals the net cost for you.
            </p>
        </field>
    </record>
</odoo>
