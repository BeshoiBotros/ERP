<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_disbursement_tag_form" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.tag.form</field>
        <field name="model">eh.daily.disbursement.tag</field>
        <field name="arch" type="xml">
            <form string="Category Tag">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Perfumes"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Allowed Products">
                        <field name="product_categ_ids" widget="many2many_tags" nolabel="1" colspan="2"
                               placeholder="All product categories"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_daily_disbursement_tag_tree" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.tag.tree</field>
        <field name="model">eh.daily.disbursement.tag</field>
        <field name="arch" type="xml">
            <tree string="Category Tags">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="product_categ_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_daily_disbursement_tag_search" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.tag.search</field>
        <field name="model">eh.daily.disbursement.tag</field>
        <field name="arch" type="xml">
            <search string="Category Tags">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_daily_disbursement_tag" model="ir.actions.act_window">
        <field name="name">Category Tags</field>
        <field name="res_model">eh.daily.disbursement.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a category tag
            </p>
            <p>
                Tags group daily sheets (e.g. Perfumes, Nail Polish) and can
                restrict which product categories a sheet accepts.
            </p>
        </field>
    </record>
</odoo>
