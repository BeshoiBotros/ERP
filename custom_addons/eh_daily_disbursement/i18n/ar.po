#: code:addons/eh_daily_disbursement/models/daily_disbursement.py:0
#, python-format
msgid ""
"%(sheet)s already covers %(date)s for %(tag)s. Add the lines there, or "
"cancel it first."
msgstr ""
"الكشف %(sheet)s يغطي بالفعل يوم %(date)s لـ %(tag)s. أضف البنود هناك أو "
"ألغِه أولاً."

#. module: eh_daily_disbursement
#. odoo-python
#: code:addons/eh_daily_disbursement/models/daily_disbursement.py:0
#, python-format
msgid ""
"%(sheet)s already has lines. Copying the previous sheet only fills an empty "
"sheet."
msgstr ""
"الكشف %(sheet)s يحتوي على بنود بالفعل. نسخ الكشف السابق يملأ الكشف الفارغ "
"فقط."

#. module: eh_daily_disbursement
#. odoo-python
#: code:addons/eh_daily_disbursement/models/daily_disbursement.py:0
#, python-format
