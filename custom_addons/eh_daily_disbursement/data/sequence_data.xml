<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- DD/<sheet year>/<month>/<day>/0001; the counter restarts each year. -->
        <record id="seq_daily_disbursement" model="ir.sequence">
            <field name="name">Daily Disbursement</field>
            <field name="code">eh.daily.disbursement</field>
            <field name="prefix">DD/%(year)s/%(month)s/%(day)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
