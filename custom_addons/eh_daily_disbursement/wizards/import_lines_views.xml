<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_disbursement_import_form" model="ir.ui.view">
        <field name="name">eh.daily.disbursement.import.form</field>
        <field name="model">eh.daily.disbursement.import</field>
        <field name="arch" type="xml">
            <form string="Import Lines">
                <field name="sheet_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <p class="mb-1">
                        Upload a <b>.csv</b> or <b>.xlsx</b> file whose first row holds these column headers:
                    </p>
                    <ul class="mb-1">
                        <li><b>product</b>: internal reference, barcode or exact product name (required)</li>
                        <li><b>type</b>: <code>out</code> or <code>return</code> (empty means out)</li>
                        <li><b>qty</b>: quantity greater than zero (required)</li>
                        <li><b>unit_cost</b>: leave empty to use today's product cost</li>
                        <li><b>note</b>: optional</li>
                    </ul>
                    <p class="mb-0">
                        Nothing is imported unless every row is valid.
                        <a href="/eh_daily_disbursement/static/templates/daily_disbursement_lines.csv" download="">
                            <i class="fa fa-download"/> Download template
                        </a>
                    </p>
                </div>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_disbursement_import" model="ir.actions.act_window">
        <field name="name">Import Lines</field>
        <field name="res_model">eh.daily.disbursement.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
