<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_program_form" model="ir.ui.view">
        <field name="name">eh.discount.program.form</field>
        <field name="model">eh.discount.program</field>
        <field name="arch" type="xml">
            <form string="Discount Program">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="%(action_eh_discount_compute_wizard)d" type="action" string="Compute Discount" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Mark as Done" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., 2026 Q1 5% Discount"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="discount_type_id"/>
                            <field name="customer_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="total_discount_pct"/>
                            <field name="company_share_pct"/>
                            <field name="vendor_share_pct"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounting Info">
                            <group>
                                <field name="discount_expense_account_id"/>
                                <field name="discount_journal_id"/>
                            </group>
                        </page>
                        <page string="Discount Entries">
                            <field name="entry_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_invoiced"/>
                                    <field name="total_discount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_discount_program_tree" model="ir.ui.view">
        <field name="name">eh.discount.program.tree</field>
        <field name="model">eh.discount.program</field>
        <field name="arch" type="xml">
            <tree string="Discount Programs">
                <field name="name"/>
                <field name="discount_type_id"/>
                <field name="customer_id"/>
                <field name="total_discount_pct"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_eh_discount_program" model="ir.actions.act_window">
        <field name="name">Discount Programs</field>
        <field name="res_model">eh.discount.program</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
