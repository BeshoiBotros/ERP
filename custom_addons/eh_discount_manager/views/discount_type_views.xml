<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_discount_type_tree" model="ir.ui.view">
        <field name="name">eh.discount.type.tree</field>
        <field name="model">eh.discount.type</field>
        <field name="arch" type="xml">
            <tree string="Discount Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_eh_discount_type" model="ir.actions.act_window">
        <field name="name">Discount Types</field>
        <field name="res_model">eh.discount.type</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
