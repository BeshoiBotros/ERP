<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_product_category_tag_form" model="ir.ui.view">
        <field name="name">eh.product.category.tag.form</field>
        <field name="model">eh.product.category.tag</field>
        <field name="arch" type="xml">
            <form string="Product Category Tag">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Perfumes"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_product_category_tag_tree" model="ir.ui.view">
        <field name="name">eh.product.category.tag.tree</field>
        <field name="model">eh.product.category.tag</field>
        <field name="arch" type="xml">
            <tree string="Product Category Tags">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_eh_product_category_tag" model="ir.actions.act_window">
        <field name="name">Category Tags</field>
        <field name="res_model">eh.product.category.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Category Tag
            </p>
        </field>
    </record>
</odoo>
