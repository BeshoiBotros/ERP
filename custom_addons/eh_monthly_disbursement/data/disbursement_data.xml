<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Monthly Disbursement -->
        <record id="seq_monthly_disbursement" model="ir.sequence">
            <field name="name">Monthly Disbursement</field>
            <field name="code">eh.monthly.disbursement</field>
            <field name="prefix">DISB/%(year)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Category Tags -->
        <record id="category_tag_nail_polish" model="eh.product.category.tag">
            <field name="name">Nail Polish</field>
            <field name="code">nail_polish</field>
        </record>
        
        <record id="category_tag_perfume" model="eh.product.category.tag">
            <field name="name">Perfumes</field>
            <field name="code">perfume</field>
        </record>
    </data>
</odoo>
